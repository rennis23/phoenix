# Local Phoenix deployment configuration.
#
# Copy this file to .env (never commit .env) or generate a secure one:
#   cp .env.example .env && chmod 600 .env
#   ./phoenix-secrets.sh init
#
# phoenix-start.sh loads .env if present. For pi-phoenix, do NOT `source` this
# file into a shell: generated secrets can contain shell metacharacters
# ($, &, *, ") that corrupt or break values when sourced. Instead, point the
# phoenix SDK at it via its hand-off file (discovered by walking up from pi's
# working directory; only PHOENIX_-prefixed keys are read, process env wins):
#   ln -sf ~/project/phoenix/.env ~/.env.phoenix
# Then start pi from a shell that has no PHOENIX_API_KEY exported.
#
# Syntax: one KEY=VALUE per line; surrounding quotes are stripped; comments
# start with '#'. Secrets may contain '$', '&', '*', '"' - safe for the .env
# loaders here (phoenix-start.sh / the SDK), unsafe to `source` directly.
# Use: ./phoenix-secrets.sh generate secret|password

# Phoenix-native authentication.
PHOENIX_ENABLE_AUTH=true
# Persistent JWT signing secret. Must be >= 32 chars with at least one digit
# and one lowercase letter. Generate with: ./phoenix-secrets.sh generate secret
PHOENIX_SECRET=
# Used only when the default admin account (admin@localhost) is first created.
# Generate with: ./phoenix-secrets.sh generate password
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=
# Require strong passwords in the Phoenix UI (>= 12 chars, mixed case, digit,
# special character).
PHOENIX_ENABLE_STRONG_PASSWORD_POLICY=true

# Optional: read secrets from the macOS Keychain instead of .env.
# Keep PHOENIX_ENABLE_AUTH / PHOENIX_ENABLE_STRONG_PASSWORD_POLICY here and set:
# PHOENIX_SECRET_SOURCE=keychain
# PHOENIX_KEYCHAIN_SERVICE=phoenix-local
# PHOENIX_KEYCHAIN_ACCOUNT=your-username

# Trace export configuration for the pi-phoenix extension.
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
# System API key created in Phoenix Settings (Settings -> System API Keys).
# The value must be a real key from the Phoenix UI; a random string generated
# here is rejected by the collector (HTTP 401 "Invalid token"). Stored here or
# in the Keychain; never commit or print it.
PHOENIX_API_KEY=
# Project name shown in Phoenix for pi sessions. Not PHOENIX_-prefixed, so it
# cannot come from .env.phoenix - set it in the environment that runs pi, or
# rely on the default (git repo / cwd basename).
PI_PHOENIX_PROJECT=phoenix
